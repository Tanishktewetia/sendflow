{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/auth",
      "destination": "/frontend/auth.html"
    },
    {
      "source": "/app",
      "destination": "/frontend/app.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/frontend/forgot-password.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/frontend/how-it-works.html"
    },
    {
      "source": "/privacy",
      "destination": "/frontend/privacy.html"
    },
    {
      "source": "/tos",
      "destination": "/frontend/tos.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
