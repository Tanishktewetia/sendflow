{
  "version": 2,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/auth/?$",
      "dest": "/auth.html"
    },
    {
      "src": "^/app/?$",
      "dest": "/app.html"
    },
    {
      "src": "^/forgot-password/?$",
      "dest": "/forgot-password.html"
    },
    {
      "src": "^/how-it-works/?$",
      "dest": "/how-it-works.html"
    },
    {
      "src": "^/privacy/?$",
      "dest": "/privacy.html"
    },
    {
      "src": "^/tos/?$",
      "dest": "/tos.html"
    }
  ]
}
